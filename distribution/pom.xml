<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>super</artifactId>
        <groupId>org.imec.ivlab.ehealth.automation</groupId>
        <version>4.0.0</version>
        <relativePath>../super</relativePath>
    </parent>
    <artifactId>distribution</artifactId>
    <version>4.0.0</version>

    <properties>
        <!-- IzPack removed -->
        <evs.executable.filename>EVS-${project.version}.jar</evs.executable.filename>
    </properties>

    <dependencies>
        <!-- IzPack dependencies removed on purpose -->
    </dependencies>

    <build>

        <plugins>

            <!-- Keep only resource copy that produces the delivery output into the build.install.directory -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- Copy example config files : actors/patients/... -> now to build.install.directory (not installer) -->
                    <execution>
                        <id>copy-delivery-output</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${build.install.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}/src/main/resources-filtered/delivery_output</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                            <includeEmptyDirs>true</includeEmptyDirs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Removed: maven-antrun-plugin that copied into izpack staging (not needed) -->

            <!-- Removed: izpack-maven-plugin and its dependencies -->

            <!-- Copy the produced artifact (EVS jar) to the build.install.directory so that builds/.../EVS contains the runtime artifact -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-installed</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${project.version}</version>
                                    <type>${project.packaging}</type>
                                    <outputDirectory>${build.install.directory}</outputDirectory>
                                    <destFileName>${evs.executable.filename}</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

</project>
