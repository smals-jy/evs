<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>super</artifactId>
        <groupId>org.imec.ivlab.ehealth.automation</groupId>
        <version>4.0.0</version>
        <relativePath>../super</relativePath>
    </parent>
    <artifactId>datagenerator</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.imec.ivlab.ehealth.automation</groupId>
            <artifactId>ehconnector</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.imec.ivlab.ehealth.automation</groupId>
            <artifactId>core</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.imec.ivlab.ehealth.automation</groupId>
            <artifactId>viewer</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.beust</groupId>
            <artifactId>jcommander</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
        </dependency>
        <dependency>
            <groupId>org.imec.ivlab.ehealth.automation</groupId>
            <artifactId>validator</artifactId>
            <version>4.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
<executions>
                    <execution>
                        <id>copy-dependencies-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${build.install.jar.directory}</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <inline>
                                <id>dependency-jars</id>
                                <formats>
                                    <format>dir</format>
                                </formats>
                                <includeBaseDirectory>false</includeBaseDirectory>
                                <dependencySets>
                                    <dependencySet>
                                        <outputDirectory>dependency-jars</outputDirectory>
                                        <useProjectArtifact>false</useProjectArtifact>
                                        <scope>runtime</scope>
                                        <excludes>
                                            <exclude>be.fgov.ehealth.standards:*</exclude>
                                            <exclude>org.imec.ivlab.ehealth.automation:*</exclude>
                                            <exclude>*:bcprov-jdk15on</exclude>
                                            <exclude>*:bcmail-jdk15on</exclude>
                                            <exclude>*:bcpkix-jdk15on</exclude>
                                        </excludes>
                                    </dependencySet>
                                </dependencySets>
                            </inline>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

    <repositories>

        <repository>
            <id>e-Contract.be</id>
            <url>https://www.e-contract.be/maven2/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>

        <repository>
            <id>eHealth</id>
            <name>eHealth</name>
            <url>https://repo.ehealth.fgov.be/artifactory/maven2/</url>
        </repository>

    </repositories>
</project>
