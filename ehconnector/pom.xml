<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <!-- Explicit versions for common libs -->
        <commons-codec.version>1.22.0</commons-codec.version>
        <joda-time.version>2.14.3</joda-time.version>
        <log4j2.version>2.26.1</log4j2.version>
    </properties>

    <parent>
        <artifactId>super</artifactId>
        <groupId>org.imec.ivlab.ehealth.automation</groupId>
        <version>5.0.0</version>
        <relativePath>../super</relativePath>
    </parent>

    <artifactId>ehconnector</artifactId>

    <dependencies>

        <!-- Commons and IO -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>${commons-codec.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <!-- eHealth / Technical connector core (kept conservatively) -->
        <!-- These artifacts are provided by the eHealth Artifactory; keep core technical/business modules. -->
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-technical-core</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-technical-bootstrap</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-technical-base</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-technical-signature</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-utilities-hubservicesv3</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-business-intrahubv3</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-business-intrahubcommons</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency> 
             
        <!-- Business / domain modules kept conservatively -->
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-business-common</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>
        <dependency>
            <groupId>be.fgov.ehealth.connector</groupId>
            <artifactId>connector-business-kmehrcommons</artifactId>
            <version>${ehealth.connector.version}</version>
        </dependency>

        <!-- Logging: keep single SLF4J binding (Log4j2) to avoid multiple runtime bindings -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

        <!-- Template engine (used in project code) -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>${apache.velocity.version}</version>
        </dependency>

        <!-- Utilities -->
        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
            <version>${joda-time.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.easymock</groupId>
            <artifactId>easymock</artifactId>
            <version>5.6.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Internal project core -->
        <dependency>
            <groupId>org.imec.ivlab.ehealth.automation</groupId>
            <artifactId>core</artifactId>
            <version>5.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
             
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>             
             
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <!-- include only runtime dependencies for packaging -->
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${build.install.jar.directory}${file.separator}dependency-jars${file.separator}</outputDirectory>
                            <!-- Exclude eHealth standards group and the local automation core if provided separately -->
                            <excludeGroupIds>be.fgov.ehealth.standards,org.imec.ivlab.ehealth.automation</excludeGroupIds>
                            <!-- Legacy BC 1.64 is not Java 21 compatible; do not place it in the distribution. -->
                            <excludeArtifactIds>bcprov-jdk15on,bcmail-jdk15on,bcpkix-jdk15on</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <!-- Do not remove entry 'src/main/resources/config/', otherwise decryption fails for GetTransactionSet method -->
                <directory>src/main/resources/config/</directory>
            </resource>
            <resource>
                <directory>src/main/resources/</directory>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>e-Contract.be</id>
            <url>https://www.e-contract.be/maven2/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>

        <repository>
            <id>eHealth</id>
            <name>eHealth</name>
            <url>https://repo.ehealth.fgov.be/artifactory/maven2/</url>
        </repository>
    </repositories>

    <!-- commons-eid BOM -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>be.fedict.commons-eid</groupId>
                <artifactId>commons-eid-bom</artifactId>
                <version>1.2.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
